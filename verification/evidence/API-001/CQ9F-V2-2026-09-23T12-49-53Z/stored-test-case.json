{
  "id": "e2c16179-325f-4fc8-95af-0052bc86435b",
  "reference": "TC-0001",
  "name": "A signed-in customer can read their accounts over the API",
  "objective": "The accounts endpoint answers for an authenticated session",
  "preconditions": "",
  "expectedResults": "",
  "kind": "api",
  "priority": "high",
  "risk": "medium",
  "tags": "api",
  "source": "manual",
  "isEnabled": true,
  "version": 1,
  "requirementReference": "",
  "testSuiteId": "bfd1029f-d51f-46f0-8cbd-917609d9486f",
  "applicationId": "51139dec-ee5d-43fc-96c2-ccee931cc4ce",
  "statistics": {
    "executionCount": 0,
    "passCount": 0,
    "failCount": 0,
    "healCount": 0,
    "flakinessScore": 0,
    "averageDurationMs": 0
  },
  "steps": [
    {
      "id": "a7d514c8-f7ef-404e-ba23-5d39032382b3",
      "order": 1,
      "description": "Sign in through the API",
      "action": "apiRequest",
      "isCritical": true,
      "continueOnFailure": false,
      "healCount": 0,
      "apiRequest": {
        "method": "POST",
        "path": "/api/session",
        "body": "{\"username\":\"alice\",\"password\":\"${secret:app_password}\"}",
        "contentType": "application/json",
        "auth": {
          "mode": "none"
        }
      },
      "assertions": [
        {
          "id": "97b335d1-0767-47e9-b409-6c265678ef10",
          "type": "httpStatusEquals",
          "expectedValue": "200",
          "attributeName": "",
          "negate": false,
          "isSoft": false,
          "description": "The response status is 200"
        },
        {
          "id": "a20b9922-2bda-4303-b7a3-7b9d096dab25",
          "type": "responseJsonPathEquals",
          "expectedValue": "alice",
          "attributeName": "user.username",
          "negate": false,
          "isSoft": false,
          "description": "user.username is alice"
        }
      ]
    },
    {
      "id": "4bcf4b6d-7693-4e1e-aa35-aeaed3ef3f03",
      "order": 2,
      "description": "Read the accounts that session can see",
      "action": "apiRequest",
      "isCritical": true,
      "continueOnFailure": false,
      "healCount": 0,
      "apiRequest": {
        "method": "GET",
        "path": "/api/accounts",
        "auth": {
          "mode": "none"
        },
        "capture": {
          "accountId": "accounts[0].id"
        }
      },
      "assertions": [
        {
          "id": "104d628a-dc9b-41df-9ec9-e56b9f72a8fe",
          "type": "httpStatusEquals",
          "expectedValue": "200",
          "attributeName": "",
          "negate": false,
          "isSoft": false,
          "description": "The response status is 200"
        },
        {
          "id": "3d761c78-4641-4adb-816e-0bf63542d711",
          "type": "responseJsonPathMatches",
          "expectedValue": "^acc-\\d+$",
          "attributeName": "accounts[0].id",
          "negate": false,
          "isSoft": false,
          "description": "accounts[0].id matches /^acc-\\d+$/"
        },
        {
          "id": "e2e91ef7-7b92-40e5-8a9c-e45e66f5a01e",
          "type": "responseJsonPathExists",
          "expectedValue": "",
          "attributeName": "accounts[0].balance",
          "negate": false,
          "isSoft": false,
          "description": "accounts[0].balance is present"
        },
        {
          "id": "f4af7348-d800-40fe-a0c9-1c3d68077488",
          "type": "responseTimeUnderMs",
          "expectedValue": "5000",
          "attributeName": "",
          "negate": false,
          "isSoft": false,
          "description": "The response arrives within 5000ms"
        }
      ]
    }
  ]
}
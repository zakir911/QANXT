{
  "id": "327736d6-06a9-44fe-ba51-446453f1b982",
  "reference": "TC-0001",
  "name": "A signed-in customer can read their accounts over the API",
  "objective": "The accounts endpoint answers for an authenticated session",
  "preconditions": "",
  "expectedResults": "",
  "kind": "api",
  "priority": "high",
  "risk": "medium",
  "tags": "api",
  "source": "manual",
  "isEnabled": true,
  "version": 1,
  "requirementReference": "",
  "testSuiteId": "1d051ae8-e35c-414f-b2b4-d316b4afc1f8",
  "applicationId": "390a2e98-b4ed-4616-a323-1f4e690ff4c5",
  "statistics": {
    "executionCount": 0,
    "passCount": 0,
    "failCount": 0,
    "healCount": 0,
    "flakinessScore": 0,
    "averageDurationMs": 0
  },
  "steps": [
    {
      "id": "caf97406-0e43-4bcc-ad8a-096793748dd9",
      "order": 1,
      "description": "Sign in through the API",
      "action": "apiRequest",
      "isCritical": true,
      "continueOnFailure": false,
      "healCount": 0,
      "apiRequest": {
        "method": "POST",
        "path": "/api/session",
        "body": "{\"username\":\"alice\",\"password\":\"${secret:app_password}\"}",
        "contentType": "application/json",
        "auth": {
          "mode": "none"
        }
      },
      "assertions": [
        {
          "id": "1c138eb0-191b-4ec8-8e9a-91a0fbf878ae",
          "type": "responseJsonPathEquals",
          "expectedValue": "alice",
          "attributeName": "user.username",
          "negate": false,
          "isSoft": false,
          "description": "user.username is alice"
        },
        {
          "id": "30bc7cdf-f029-42b5-8920-c4763feaf89e",
          "type": "httpStatusEquals",
          "expectedValue": "200",
          "attributeName": "",
          "negate": false,
          "isSoft": false,
          "description": "The response status is 200"
        }
      ]
    },
    {
      "id": "c96eb9d4-d1a0-442f-8d13-eabbfb77f898",
      "order": 2,
      "description": "Read the accounts that session can see",
      "action": "apiRequest",
      "isCritical": true,
      "continueOnFailure": false,
      "healCount": 0,
      "apiRequest": {
        "method": "GET",
        "path": "/api/accounts",
        "auth": {
          "mode": "none"
        },
        "capture": {
          "accountId": "accounts[0].id"
        }
      },
      "assertions": [
        {
          "id": "db573127-e87e-41ff-885a-2c5a54dd799c",
          "type": "responseTimeUnderMs",
          "expectedValue": "5000",
          "attributeName": "",
          "negate": false,
          "isSoft": false,
          "description": "The response arrives within 5000ms"
        },
        {
          "id": "439140f3-2eb7-4546-ab42-131d7b5ddeb3",
          "type": "responseJsonPathMatches",
          "expectedValue": "^acc-\\d+$",
          "attributeName": "accounts[0].id",
          "negate": false,
          "isSoft": false,
          "description": "accounts[0].id matches /^acc-\\d+$/"
        },
        {
          "id": "64144139-dcaf-4785-a9bd-5b59cc8ae3c4",
          "type": "httpStatusEquals",
          "expectedValue": "200",
          "attributeName": "",
          "negate": false,
          "isSoft": false,
          "description": "The response status is 200"
        },
        {
          "id": "ffe42f2b-3412-417b-8a2e-aec748367f9c",
          "type": "responseJsonPathExists",
          "expectedValue": "",
          "attributeName": "accounts[0].balance",
          "negate": false,
          "isSoft": false,
          "description": "accounts[0].balance is present"
        }
      ]
    }
  ]
}
{
  "id": "91a9da91-9da5-4e21-93d9-ca50157e0d81",
  "reference": "TC-0001",
  "name": "A signed-in customer can read their accounts over the API",
  "objective": "The accounts endpoint answers for an authenticated session",
  "preconditions": "",
  "expectedResults": "",
  "kind": "api",
  "priority": "high",
  "risk": "medium",
  "tags": "api",
  "source": "manual",
  "isEnabled": true,
  "version": 1,
  "requirementReference": "",
  "testSuiteId": "41422e39-cb9c-4d58-bc60-98cf3766cec7",
  "applicationId": "2bd4fce5-9dd7-4bb1-9a4d-42a90821b80e",
  "statistics": {
    "executionCount": 0,
    "passCount": 0,
    "failCount": 0,
    "healCount": 0,
    "flakinessScore": 0,
    "averageDurationMs": 0
  },
  "steps": [
    {
      "id": "dd34badc-edc3-4d5b-a0ef-0c3496e244bc",
      "order": 1,
      "description": "Sign in through the API",
      "action": "apiRequest",
      "isCritical": true,
      "continueOnFailure": false,
      "healCount": 0,
      "apiRequest": {
        "method": "POST",
        "path": "/api/session",
        "body": "{\"username\":\"alice\",\"password\":\"${secret:app_password}\"}",
        "contentType": "application/json",
        "auth": {
          "mode": "none"
        }
      },
      "assertions": [
        {
          "id": "681cca6b-20c3-4a21-a480-7b4215e6f2dc",
          "type": "responseJsonPathEquals",
          "expectedValue": "alice",
          "attributeName": "user.username",
          "negate": false,
          "isSoft": false,
          "description": "user.username is alice"
        },
        {
          "id": "aa872512-95d8-432c-a2ea-0d909e8f259b",
          "type": "httpStatusEquals",
          "expectedValue": "200",
          "attributeName": "",
          "negate": false,
          "isSoft": false,
          "description": "The response status is 200"
        }
      ]
    },
    {
      "id": "28ef7495-ce8f-4903-9846-161173ad40b5",
      "order": 2,
      "description": "Read the accounts that session can see",
      "action": "apiRequest",
      "isCritical": true,
      "continueOnFailure": false,
      "healCount": 0,
      "apiRequest": {
        "method": "GET",
        "path": "/api/accounts",
        "auth": {
          "mode": "none"
        },
        "capture": {
          "accountId": "accounts[0].id"
        }
      },
      "assertions": [
        {
          "id": "1c7c9bcf-8663-4758-b628-1afce4f76b0b",
          "type": "responseTimeUnderMs",
          "expectedValue": "5000",
          "attributeName": "",
          "negate": false,
          "isSoft": false,
          "description": "The response arrives within 5000ms"
        },
        {
          "id": "63f51897-8d19-4df5-9113-d07e9cde38cf",
          "type": "responseJsonPathExists",
          "expectedValue": "",
          "attributeName": "accounts[0].balance",
          "negate": false,
          "isSoft": false,
          "description": "accounts[0].balance is present"
        },
        {
          "id": "ce84d019-c700-4eee-94bc-1961da598de6",
          "type": "httpStatusEquals",
          "expectedValue": "200",
          "attributeName": "",
          "negate": false,
          "isSoft": false,
          "description": "The response status is 200"
        },
        {
          "id": "f5484015-ae15-49e5-9933-4bc33b55df26",
          "type": "responseJsonPathMatches",
          "expectedValue": "^acc-\\d+$",
          "attributeName": "accounts[0].id",
          "negate": false,
          "isSoft": false,
          "description": "accounts[0].id matches /^acc-\\d+$/"
        }
      ]
    }
  ]
}
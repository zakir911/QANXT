{
  "id": "5578ac13-c82f-4631-b933-36551f4fb2b9",
  "reference": "TC-0001",
  "name": "A signed-in customer can read their accounts over the API",
  "objective": "The accounts endpoint answers for an authenticated session",
  "preconditions": "",
  "expectedResults": "",
  "kind": "api",
  "priority": "high",
  "risk": "medium",
  "tags": "api",
  "source": "manual",
  "isEnabled": true,
  "version": 1,
  "requirementReference": "",
  "testSuiteId": "362daf9f-444b-43f2-b8de-30ef987a2738",
  "applicationId": "475716e2-d197-41d4-9c30-b4ccdeda7458",
  "statistics": {
    "executionCount": 0,
    "passCount": 0,
    "failCount": 0,
    "healCount": 0,
    "flakinessScore": 0,
    "averageDurationMs": 0
  },
  "steps": [
    {
      "id": "7cf5ab2d-6cda-42d3-9acc-0afba7e440f8",
      "order": 1,
      "description": "Sign in through the API",
      "action": "apiRequest",
      "isCritical": true,
      "continueOnFailure": false,
      "healCount": 0,
      "apiRequest": {
        "method": "POST",
        "path": "/api/session",
        "body": "{\"username\":\"alice\",\"password\":\"${secret:app_password}\"}",
        "contentType": "application/json",
        "auth": {
          "mode": "none"
        }
      },
      "assertions": [
        {
          "id": "1f99fb5d-41b3-4026-a32b-f4e9097087be",
          "type": "responseJsonPathEquals",
          "expectedValue": "alice",
          "attributeName": "user.username",
          "negate": false,
          "isSoft": false,
          "description": "user.username is alice"
        },
        {
          "id": "7886ae20-4b29-4cac-a663-f52daf27abe2",
          "type": "httpStatusEquals",
          "expectedValue": "200",
          "attributeName": "",
          "negate": false,
          "isSoft": false,
          "description": "The response status is 200"
        }
      ]
    },
    {
      "id": "64c1d6ed-a754-40a5-9f84-5eb2837296b0",
      "order": 2,
      "description": "Read the accounts that session can see",
      "action": "apiRequest",
      "isCritical": true,
      "continueOnFailure": false,
      "healCount": 0,
      "apiRequest": {
        "method": "GET",
        "path": "/api/accounts",
        "auth": {
          "mode": "none"
        },
        "capture": {
          "accountId": "accounts[0].id"
        }
      },
      "assertions": [
        {
          "id": "0fb2fed5-495f-45d4-a4ac-5ed78bc77ecb",
          "type": "responseTimeUnderMs",
          "expectedValue": "5000",
          "attributeName": "",
          "negate": false,
          "isSoft": false,
          "description": "The response arrives within 5000ms"
        },
        {
          "id": "aaa124cb-20b9-4986-93da-2e358d152eda",
          "type": "responseJsonPathMatches",
          "expectedValue": "^acc-\\d+$",
          "attributeName": "accounts[0].id",
          "negate": false,
          "isSoft": false,
          "description": "accounts[0].id matches /^acc-\\d+$/"
        },
        {
          "id": "b7bd96f3-1b99-47c8-878c-53b02071052a",
          "type": "responseJsonPathExists",
          "expectedValue": "",
          "attributeName": "accounts[0].balance",
          "negate": false,
          "isSoft": false,
          "description": "accounts[0].balance is present"
        },
        {
          "id": "e69b5b49-9059-4c16-8ddf-9a771a6cc015",
          "type": "httpStatusEquals",
          "expectedValue": "200",
          "attributeName": "",
          "negate": false,
          "isSoft": false,
          "description": "The response status is 200"
        }
      ]
    }
  ]
}
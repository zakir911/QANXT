# The web console.
#
# Vite inlines VITE_* values at build time, so the API URL is a build argument rather than a
# runtime environment variable. That is a real constraint worth knowing: pointing a built
# image at a different API means rebuilding it, or serving the console from the same origin
# as the API behind one reverse proxy.
FROM node:22-bookworm-slim AS build
WORKDIR /src

# Corporate networks often terminate TLS at an inspecting proxy, which makes a package
# restore fail with an opaque certificate error. Any .crt dropped into
# infrastructure/docker/certs/ is trusted here; the directory is otherwise empty, so this is
# a no-op for everyone else.
COPY infrastructure/docker/certs/ /usr/local/share/ca-certificates/qanxt-extra/
RUN update-ca-certificates >/dev/null 2>&1 || true

RUN corepack enable && corepack prepare pnpm@10 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/cli/package.json ./packages/cli/
COPY apps/browser-worker/package.json ./apps/browser-worker/
COPY apps/web-console/package.json ./apps/web-console/
COPY apps/browser-extension/package.json ./apps/browser-extension/
COPY samples/demo-bank/package.json ./samples/demo-bank/
COPY tests/e2e/package.json ./tests/e2e/

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN pnpm install --frozen-lockfile --filter @qa-nxt/web-console...

COPY packages/shared-types/ ./packages/shared-types/
COPY apps/web-console/ ./apps/web-console/

ARG VITE_API_URL=http://localhost:5080
ARG VITE_PRODUCT_NAME="QA NXT"
ENV VITE_API_URL=$VITE_API_URL VITE_PRODUCT_NAME=$VITE_PRODUCT_NAME
RUN pnpm --filter @qa-nxt/web-console... build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /src/apps/web-console/dist /usr/share/nginx/html
COPY infrastructure/docker/console-nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD ["/bin/sh", "-c", "wget -qO- http://127.0.0.1:8080/ >/dev/null || exit 1"]

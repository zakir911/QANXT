// QA NXT validating an application on every build.
//
// NOT VERIFIED in this repository: running it needs a Jenkins controller and a deployment of
// QA NXT it can reach. The CLI behaviour it depends on is executed by the golden suite, and
// the whole sequence is executed locally by test-lab/ci-simulation.
//
// Credentials this needs: a secret text credential holding the QA NXT token.

pipeline {
  agent { docker { image 'node:22' } }

  environment {
    QANXT_API_URL    = "${env.QANXT_API_URL}"
    QANXT_PROJECT_ID = "${env.QANXT_PROJECT_ID}"
    QANXT_ENVIRONMENT_ID = "${env.QANXT_ENVIRONMENT_ID}"
    QANXT_TOKEN      = credentials('qanxt-token')
    ARTIFACTS       = 'qanxt-artifacts'
  }

  options {
    timeout(time: 60, unit: 'MINUTES')
  }

  stages {
    stage('Checkout') {
      steps {
        // `qanxt regression --since` needs history to diff against; a shallow clone has none.
        checkout scmGit(
          branches: scm.branches,
          extensions: [cloneOption(shallow: false, noTags: false)],
          userRemoteConfigs: scm.userRemoteConfigs)
      }
    }

    stage('Install') {
      steps { sh 'npm install -g @qa-nxt/cli' }
    }

    stage('Deploy') {
      steps {
        script { env.APP_URL = "https://app-${env.BUILD_NUMBER}.example.com" }
      }
    }

    stage('Wait for the deployment') {
      steps {
        // Before any test runs. A run against an application that has not finished
        // starting reports failures that belong to the deployment.
        sh '''
          for _ in $(seq 1 60); do
            curl -fsS --max-time 5 "$APP_URL/health" > /dev/null && exit 0
            sleep 3
          done
          echo "The deployment did not become healthy."
          exit 1
        '''
      }
    }

    stage('Run the tests this change needs') {
      steps {
        script {
          def status = sh(returnStatus: true, script: '''
            qanxt regression run \
              --since "origin/${CHANGE_TARGET:-main}" \
              --mode "${QANXT_MODE:-impacted}" \
              --explain \
              --report-dir "$ARTIFACTS" \
              --ci-provider jenkins \
              --ci-build "$BUILD_NUMBER" \
              --ci-commit "$GIT_COMMIT" \
              --ci-branch "$BRANCH_NAME"
          ''')

          // The exit code decides, and each code goes to different people.
          switch (status) {
            case 0: echo 'PASS'; break
            case 1: error 'Tests failed. See summary.md in the artifacts.'
            case 2: error 'The quality gate blocked this run.'
            case 3: error 'QA NXT was configured wrongly — whoever edited this pipeline should look.'
            case 4: error 'QA NXT rejected the credentials.'
            case 5: error 'QA NXT could not be used. The platform operator should look.'
            case 6: error 'A security policy refused this run. Do not retry without reading why.'
            case 7:
              // REVIEW is not a failure. Whether it stops the pipeline is this team's
              // decision, which is why QA NXT gives it a code of its own.
              unstable 'This run needs a person to look at it. See summary.md.'
              break
            case 8: error 'QA NXT failed internally. This is a defect in QA NXT.'
            default: error "QA NXT exited ${status}, which is not a code it documents."
          }
        }
      }
    }
  }

  post {
    // Always: a failed run is the one whose evidence somebody needs.
    always {
      junit allowEmptyResults: true, testResults: "${ARTIFACTS}/junit.xml"
      archiveArtifacts artifacts: "${ARTIFACTS}/**", allowEmptyArchive: true

      script {
        if (env.CHANGE_ID && fileExists("${ARTIFACTS}/summary.md")) {
          // Posted by Jenkins, because it already has the credentials to comment.
          pullRequest.comment(readFile("${ARTIFACTS}/summary.md"))
        }
      }
    }
  }
}

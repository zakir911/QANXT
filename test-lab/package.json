{
  "name": "@aira/test-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The QA test lab: real applications with known behaviour and controlled faults, used to prove what AIRA can do",
  "scripts": {
    "build": "vite build --config banking-app/vite.config.js",

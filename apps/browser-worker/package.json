{
  "name": "@aira/browser-worker",
  "version": "0.1.0",
  "private": true,
  "description": "AIRA execution plane: Playwright-driven discovery, test execution, evidence capture and locator healing",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aira/security-engine": "workspace:*",
    "@aira/shared-types": "workspace:*",
    "axe-core": "4.13.0",
    "ioredis": "^5.4.2",
    "pixelmatch": "7.2.0",
    "playwright": "1.56.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}

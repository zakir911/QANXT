{
  "manifest_version": 3,
  "name": "QA NXT Journey Recorder",
  "version": "0.1.0",
  "description": "Record a user journey through a web application and hand it to QA NXT to turn into an automated test.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QA NXT Journey Recorder",
    "default_icon": { "128": "icons/icon128.png" }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": { "128": "icons/icon128.png" }
}

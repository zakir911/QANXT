{
  "Product": {
    "Name": "AIRA",
    "Tagline": "Your AI Quality Engineer",
    "Version": "0.1.0"
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=aira;Username=aira;Password=aira",
    "Redis": "localhost:6379"
  },
  "Database": {
    "AutoMigrate": true,
    "EnableSensitiveDataLogging": false
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "aira",
    "Audience": "aira-console",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "Encryption": {
    "Key": ""
  },
  "Storage": {
    "Provider": "filesystem",
    "Root": "./storage",
    "Bucket": "aira-artifacts",
    "RetentionDays": 30
  },
  "Security": {
    "CorsOrigins": [ "http://localhost:5173" ],
    "RateLimitPermitPerMinute": 300,
    "GlobalTargetAllowlist": [],
    "AllowPrivateNetworkTargets": false,
    "WorkerToken": ""
  },
  "Ai": {
    "DefaultProvider": "local",
    "CacheEnabled": true,
    "MaxTokensPerRequest": 8000,
    "MonthlyBudgetUsd": 0
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information" }
  },
  "AllowedHosts": "*"
}

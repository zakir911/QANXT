#!/usr/bin/env bash
# Runs the golden test suite and writes the reports.
#
#   scripts/run-golden-tests --all
#   scripts/run-golden-tests --suite discovery --suite healing
#
# Exits non-zero if any test marked `critical` failed, which is the signal a pipeline
# should key off.
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

export GOLDEN_RUN_ID="${GOLDEN_RUN_ID:-$(date -u +%Y-%m-%dT%H-%M-%SZ)}"

printf '\033[1mGolden tests — run %s\033[0m\n' "$GOLDEN_RUN_ID"

node verification/golden-tests/run.mjs "$@"
suite_status=$?

# The report is generated whatever the suites did: a failed run is exactly when its
# numbers are most worth having.
node verification/golden-tests/report.mjs --run "$GOLDEN_RUN_ID"
report_status=$?

if [[ $suite_status -ne 0 ]]; then
  printf '\n\033[31mGolden tests failed.\033[0m See verification/reports/GOLDEN-TEST-REPORT.md\n'
  exit $suite_status
fi
if [[ $report_status -ne 0 ]]; then
  printf '\n\033[31mA quality gate did not pass.\033[0m See verification/reports/GOLDEN-TEST-REPORT.md\n'
  exit $report_status
fi

printf '\n\033[32mGolden tests passed.\033[0m Reports in verification/reports/\n'

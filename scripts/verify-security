#!/usr/bin/env bash
# Security testing, from nothing to a traceability matrix.
#
#   ./scripts/verify-security
#   ./scripts/verify-security --no-platform   # skip AIRA's own API; scan the lab only
#
#   infrastructure → security lab → ground-truth audit → unit tests → security suites
#   → report → traceability
#
# What this script asserts, precisely: that AIRA's security testing finds each flaw planted
# in its lab, says nothing about the endpoints that are correct, refuses everything the scope
# does not authorize, and reports what it did not test. It does not assert that any
# application is secure, and neither does anything it produces.
#
# Exits non-zero if any suite failed or any security requirement is unverified.
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

section() { printf '\n\033[1m── %s ──\033[0m\n' "$1"; }
fail() { printf '\n\033[31m%s\033[0m\n' "$1"; exit 1; }
note() { printf '\033[2m%s\033[0m\n' "$1"; }

WITH_PLATFORM=true
for arg in "$@"; do [[ "$arg" == "--no-platform" ]] && WITH_PLATFORM=false; done

export GOLDEN_RUN_ID="${GOLDEN_RUN_ID:-SEC-$(date -u +%Y-%m-%dT%H-%M-%SZ)}"

# The scanning and gate suites need only the lab. `security-platform` exercises scopes, scans,
# findings and triage through AIRA's own API, and `security` exercises AIRA's own tenancy,
# credential handling and target policy — both need the platform.
SUITES=(security-scan security-gate)
$WITH_PLATFORM && SUITES+=(security-platform security)

if $WITH_PLATFORM; then
  section "Infrastructure"
  bash scripts/services-ctl.sh --with-database || fail "PostgreSQL and Redis did not start."

  section "AIRA"
  bash scripts/api-ctl.sh start && bash scripts/api-ctl.sh wait || fail "The API did not start."
  bash scripts/worker-ctl.sh start || fail "The worker did not start."
fi

section "Security lab"
bash test-lab/scripts/lab-ctl.sh start || fail "The security lab did not start."

section "Ground truth"
# Before anything is measured. If the lab and its ground truth disagree, a missed detection
# might be a vulnerability that was never there and a false positive might be a real flaw
# nobody wrote down — and every number below would be taken with a broken ruler.
node test-lab/security/audit-ground-truth.mjs \
  || fail "The security lab and its ground truth disagree. Nothing measured against it would mean anything."

section "Unit tests"
# The scope guard, the severity model and the gate are pure functions with no application
# involved, and they are where the controls actually live.
dotnet test apps/api/tests/Aira.UnitTests/Aira.UnitTests.csproj -v q --nologo \
  --filter "FullyQualifiedName~Security" \
  || fail "The security unit tests did not pass."

section "Security suites"
note "${#SUITES[@]} suite(s): ${SUITES[*]}"
suite_args=()
for suite in "${SUITES[@]}"; do suite_args+=(--suite "$suite"); done

node verification/golden-tests/run.mjs "${suite_args[@]}"
golden_status=$?

section "Security report"
node verification/golden-tests/security-report.mjs --run "$GOLDEN_RUN_ID"
report_status=$?

section "Constraints"
# The eighteen rules this capability was built against, each mapped to the tests that hold
# it. Checked rather than maintained: a map like that is true the day it is written and rots
# quietly afterwards, and it is the most load-bearing claim in the security documentation.
node verification/golden-tests/security-constraints.mjs --run "$GOLDEN_RUN_ID"
constraints_status=$?

section "Traceability"
node verification/golden-tests/traceability.mjs \
  --run "$GOLDEN_RUN_ID" \
  --requirements security-requirements.json \
  --out reports/SECURITY-TRACEABILITY.md
traceability_status=$?

printf '\n'
if [[ $golden_status -ne 0 ]]; then
  printf '\033[31mSecurity verification FAILED: a suite did not pass.\033[0m\n'
  printf '  Report:       verification/reports/SECURITY-VERIFICATION-REPORT.md\n'
  exit 1
fi
if [[ $traceability_status -ne 0 ]]; then
  printf '\033[31mSecurity verification FAILED: a requirement is not verified.\033[0m\n'
  printf '  Traceability: verification/reports/SECURITY-TRACEABILITY.md\n'
  exit 1
fi
if [[ $constraints_status -ne 0 ]]; then
  printf '\033[31mSecurity verification FAILED: the constraint map does not hold.\033[0m\n'
  printf '  Map: docs/security/constraints.md\n'
  exit 1
fi
if [[ $report_status -ne 0 ]]; then
  printf '\033[31mThe security report could not be produced.\033[0m\n'
  exit $report_status
fi

printf '\033[32mAIRA'"'"'s security testing is verified against its own lab.\033[0m\n'
printf '\033[2mThis says that the security tests do what they claim. It is not a statement that any\n'
printf 'application is secure, and nothing produced here should be read as one.\033[0m\n'
printf '  Report:       verification/reports/SECURITY-VERIFICATION-REPORT.md\n'
printf '  HTML:         verification/reports/security-verification-report.html\n'
printf '  Traceability: verification/reports/SECURITY-TRACEABILITY.md\n'
printf '  Constraints:  docs/security/constraints.md\n'
printf '  Evidence:     verification/evidence/<TEST-ID>/%s/\n' "$GOLDEN_RUN_ID"

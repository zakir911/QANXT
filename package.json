{
  "name": "qa-nxt",
  "private": true,
  "version": "0.1.0",
  "description": "QA NXT — AI autonomous web application testing platform",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "demo-bank": "pnpm --filter @qa-nxt/demo-bank start",
    "worker": "pnpm --filter @qa-nxt/browser-worker start",
    "console": "pnpm --filter @qa-nxt/web-console dev"
  }
}

{
  "name": "@aira/cli",
  "version": "0.1.0",
  "private": true,
  "description": "AIRA command line: drive runs and discovery from a terminal or a CI pipeline",
  "type": "module",
  "bin": {
    "aira": "./dist/aira.js"
  },
  "main": "dist/aira.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/aira.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aira/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}

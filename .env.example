# ============================================================================
# QA NXT — environment configuration template.
# Copy to `.env` and fill in. NEVER commit a real .env.
# ============================================================================

# ---- Branding -------------------------------------------------------------
PRODUCT_NAME="QA NXT"
PRODUCT_TAGLINE="Your AI Quality Engineer"

# ---- Core data stores -----------------------------------------------------
DATABASE_URL="Host=localhost;Port=5432;Database=qanxt;Username=qanxt;Password=qanxt"
REDIS_URL=localhost:6379

# ---- API ------------------------------------------------------------------
API_URL=http://localhost:5080
API_PORT=5080
ASPNETCORE_ENVIRONMENT=Development

# 32+ char random string. Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_dev_only_secret_at_least_32_characters_long
JWT_ISSUER=qanxt
JWT_AUDIENCE=qanxt-console
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=14

# AES-256 key used to encrypt stored secrets (base64, 32 bytes).
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_base64_32_byte_key_for_local_development_only=

# Shared secret the browser workers use to authenticate to the API.
WORKER_TOKEN=CHANGE_ME_worker_shared_secret

# ---- Artifact storage -----------------------------------------------------
# filesystem | s3
STORAGE_PROVIDER=filesystem
STORAGE_ROOT=./storage
STORAGE_BUCKET=qanxt-artifacts
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
ARTIFACT_RETENTION_DAYS=30

# ---- AI providers ---------------------------------------------------------
# openai | anthropic | gemini | local
AI_DEFAULT_PROVIDER=local
AI_CACHE_ENABLED=true
AI_MAX_TOKENS_PER_REQUEST=8000
AI_MONTHLY_BUDGET_USD=0

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.0-flash

# ---- Browser worker -------------------------------------------------------
WORKER_ID=worker-local-1
WORKER_CONCURRENCY=2
WORKER_HEADLESS=true
WORKER_DEFAULT_BROWSER=chromium
WORKER_ACTION_TIMEOUT_MS=15000
WORKER_NAVIGATION_TIMEOUT_MS=30000
PLAYWRIGHT_BROWSERS_PATH=

# ---- Security -------------------------------------------------------------
# Comma-separated hosts the platform is allowed to test. Empty = per-application allowlist only.
GLOBAL_TARGET_ALLOWLIST=
ALLOW_PRIVATE_NETWORK_TARGETS=true
RATE_LIMIT_PERMIT_PER_MINUTE=300
# Sign-in, registration and refresh, per client address. Deliberately low to blunt
# brute-force attempts; raise it if a shared egress address puts many real users
# behind one partition.
AUTH_RATE_LIMIT_PERMIT_PER_MINUTE=10
# Browser workers are part of the platform, not tenants spending a quota. Artifact uploads
# dominate this; too low and evidence is dropped under concurrency.
WORKER_RATE_LIMIT_PERMIT_PER_MINUTE=6000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Web console ----------------------------------------------------------
VITE_API_URL=http://localhost:5080
VITE_PRODUCT_NAME="QA NXT"

# ---- Demo banking application --------------------------------------------
DEMO_BANK_PORT=4200
DEMO_BANK_URL=http://localhost:4200
